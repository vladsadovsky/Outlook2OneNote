# Outlook2OneNote v2 — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real credentials.

# Azure App Registration — Application (client) ID from Azure Portal
VITE_CLIENT_ID=your-azure-client-id-here

# Authority tenant: 'common' (MSA + Entra), 'consumers' (MSA only), 'organizations' (Entra only)
VITE_TENANT_ID=common

# Account type policy (admin-controlled, not user-facing)
# Values: all | msa-only | entra-only
VITE_ACCOUNT_TYPE_POLICY=all
